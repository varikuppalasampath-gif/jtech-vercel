{
  "name": "jtech-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch --watch-path=server/index.js server/index.js",
    "build": "vite build && node scripts/prerender.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "framer-motion": "^11.11.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.454.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^6.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "vite": "^5.4.0"
  }
}